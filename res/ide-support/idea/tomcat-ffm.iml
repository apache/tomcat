<!-- The code that uses the FFM API and its tests. They need Java @RELEASE_JAVA_VERSION@ or later rather than the Java
     @BUILD_JAVA_VERSION@ the rest of Tomcat targets, so they are a module of their own. It uses the project SDK and
     the project language level, which follows the SDK. The build compiles this code for Java @RELEASE_JAVA_VERSION@,
     so code that needs a later version is accepted here but fails the build. Its content roots are nested in the
     java and test folders of the tomcat module, which gives this module those directories. ant ide-intellij only
     adds this module when it runs on Java @RELEASE_JAVA_VERSION@ or later. !-->
<module type="JAVA_MODULE" version="4">
  <component name="NewModuleRootManager" inherit-compiler-output="true">
    <exclude-output />
    <content url="file://$MODULE_DIR$/java/org/apache/tomcat/util/net/openssl/panama">
      <sourceFolder url="file://$MODULE_DIR$/java/org/apache/tomcat/util/net/openssl/panama" isTestSource="false"
          packagePrefix="org.apache.tomcat.util.net.openssl.panama" />
    </content>
    <content url="file://$MODULE_DIR$/java/org/apache/tomcat/util/openssl">
      <sourceFolder url="file://$MODULE_DIR$/java/org/apache/tomcat/util/openssl" isTestSource="false"
          packagePrefix="org.apache.tomcat.util.openssl" />
    </content>
    <content url="file://$MODULE_DIR$/test/org/apache/tomcat/util/net/openssl/panama">
      <sourceFolder url="file://$MODULE_DIR$/test/org/apache/tomcat/util/net/openssl/panama" isTestSource="true"
          packagePrefix="org.apache.tomcat.util.net.openssl.panama" />
    </content>
    <orderEntry type="inheritedJdk" />
    <orderEntry type="sourceFolder" forTests="false" />
    <!-- The tests also use test classes of the tomcat module, such as TesterSupport !-->
    <orderEntry type="module" module-name="tomcat" />

    <!-- The tomcat module does not export its libraries, so the tests declare the ones they need !-->
    <orderEntry type="module-library" scope="TEST">
      <library>
        <CLASSES>
          <root url="jar://@JUNIT_JAR@!/" />
        </CLASSES>
        <JAVADOC />
        <SOURCES />
      </library>
    </orderEntry>
    <orderEntry type="module-library" scope="TEST">
      <library>
        <CLASSES>
          <root url="jar://@HAMCREST_JAR@!/" />
        </CLASSES>
        <JAVADOC />
        <SOURCES />
      </library>
    </orderEntry>
  </component>
</module>
