<jsp:root xmlns:jsp="http://java.sun.com/JSP/Page" version="2.0">
  <!--
    Regression tests for the handling of adjacent template text nodes -
    produced by CDATA sections - in the body of a jsp:attribute action.
    Expected results are given in comments below. Each element name encodes
    the trim setting: e* for trim="true" (the default), t* for trim="false".
  -->
  <!-- Middle white-space only node removed, trailing node trimmed: "x tail" -->
  <jsp:element name="e1"><jsp:attribute name="a"><jsp:text>x</jsp:text><![CDATA[ ]]><![CDATA[ tail ]]></jsp:attribute></jsp:element>
  <!-- Both consecutive white-space only middle nodes removed: "x" -->
  <jsp:element name="e2"><jsp:attribute name="a"><jsp:text>x</jsp:text><![CDATA[ ]]><![CDATA[ ]]></jsp:attribute></jsp:element>
  <!-- Second of two consecutive white-space only middle nodes removed: "xy" -->
  <jsp:element name="e3"><jsp:attribute name="a"><jsp:text>x</jsp:text><![CDATA[ ]]><![CDATA[ ]]><jsp:text>y</jsp:text></jsp:attribute></jsp:element>
  <!-- Single CDATA between text nodes, trailing node trimmed: "x y" -->
  <jsp:element name="e4"><jsp:attribute name="a">x<![CDATA[ ]]> y </jsp:attribute></jsp:element>
  <!-- Leading and trailing white-space only nodes kept verbatim: "  " -->
  <jsp:element name="t5"><jsp:attribute name="a" trim="false"><![CDATA[ ]]><![CDATA[ ]]></jsp:attribute></jsp:element>
  <!-- Middle node removed, trailing node kept verbatim: "x tail " -->
  <jsp:element name="t6"><jsp:attribute name="a" trim="false">x<![CDATA[ ]]><![CDATA[ tail ]]></jsp:attribute></jsp:element>
</jsp:root>
